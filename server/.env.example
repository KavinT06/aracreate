PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chatapp?retryWrites=true&w=majority
JWT_SECRET=dev_jwt_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Optional: add a comma-separated list if you deploy the frontend elsewhere.
# CLIENT_URLS=https://your-frontend.vercel.app,https://another-domain.example

# If your Atlas password contains special characters, URL-encode it before pasting.
# Production example for Render + MongoDB Atlas:
# CLIENT_URL=https://your-vercel-app.vercel.app