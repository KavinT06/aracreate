# ─── Local Development ─────────────────────────────────────────────────────────
# The Vite dev server proxies /api and /socket.io to localhost:5000
# so you can leave these as-is for local dev.
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=

# ─── Production (Render – monorepo, single service) ────────────────────────────
# When the Express server serves the built React app on the SAME origin,
# relative paths work. Leave both empty or set to your Render URL:
#
# VITE_API_BASE_URL=https://aracreate.onrender.com/api
# VITE_SOCKET_URL=https://aracreate.onrender.com